# Copy to deploy.env (gitignored) and fill in for your infrastructure. Sourced by deploy.sh and deploy-cdn.sh.

# --- where to deploy (ssh + paths) ---
DEPLOY_HOST=your-server.example.com          # ssh host serving both the frontend and the CDN
WEB_DEST=/var/www/broodmother                # frontend document root (served under WEB_BASE_URL)
CDN_DEST=/data/cdn/broodmother               # asset dir (served under VITE_ASSET_BASE)

# --- production build URLs (baked into the frontend at build time) ---
VITE_BASE=/broodmother/                       # subpath the app is served under (trailing slash)
VITE_ASSET_BASE=https://cdn.datdota.com/broodmother   # where models/terrain/demo/minimap are served
VITE_API_BASE=https://gc.datdota.com          # public REST base
VITE_WS_BASE=wss://gc.datdota.com             # public WebSocket base
# VITE_API_TOKEN stays empty in production → the public experience.

# For reference only (not used by the scripts): the frontend's public URL, e.g. https://datdota.com/broodmother/
