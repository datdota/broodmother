# Copy to .env and adjust. Vite reads this (it lives in the viewer/ dev root).

# Which backend the dev proxy points /api and /ws at:
#   local  -> http://127.0.0.1:8111 (run the telekinesis stack yourself)
#   public -> https://gc.datdota.com (frontend-only work against the live backend)
DOTA_BACKEND=local
# Explicit override of the proxy target (wins over DOTA_BACKEND):
# DOTA_SERVER=http://127.0.0.1:8111

# Where the viewer loads models / terrain / fixtures from.
#   empty  -> locally-served public/ (use this when working on the extraction pipeline)
#   a URL  -> the CDN (what most people use)
# VITE_ASSET_BASE=https://cdn.datdota.com/broodmother
VITE_ASSET_BASE=

# Backend base URLs for a PRODUCTION build (not proxied). Empty = same-origin (dev proxy handles it).
# VITE_API_BASE=https://gc.datdota.com
# VITE_WS_BASE=wss://gc.datdota.com
VITE_API_BASE=
VITE_WS_BASE=

# Auth token for the PRIVATE API. LEAVE EMPTY for the public experience (the default): the viewer uses the
# unauthenticated /api/v2/public API + WebSocket join tickets, and shows live games only. Set it (your backend's
# API_AUTH_TOKEN, e.g. "dev-local-token" locally) to unlock the authenticated /api/v2/private endpoints — live
# games + replays. Sent as `Authorization: Bearer` on REST; a ?token= in the page URL overrides this.
VITE_API_TOKEN=
